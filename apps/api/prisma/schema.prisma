generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  ORG_OWNER
  ORG_ADMIN
  ORG_MEMBER
}

enum ProjectRole {
  CLIENT_ADMIN
  PROJECT_PM
  GROUP_ADMIN
  PARTICIPANT
  EXTERNAL_PARTNER
  READ_ONLY
  PROJECT_ADMIN
  PROJECT_MANAGER
  CONTRIBUTOR
  REVIEWER
  VIEWER
}

enum PlatformRole {
  PLATFORM_ADMIN
  USER
}

enum GroupRole {
  GROUP_ADMIN
  MEMBER
  READ_ONLY
}

enum ProjectStatus {
  PREPARING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum FeedPostType {
  NOTICE
  GENERAL
  QUESTION
  ISSUE
  DECISION
}

enum IssueStatus {
  REGISTERED
  UNDER_REVIEW
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum IssuePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum AttachmentStatus {
  PREPARED
  AVAILABLE
  FAILED
}

enum DriveVersionStatus {
  PREPARED
  AVAILABLE
  FAILED
}

enum CalendarEventKind {
  EVENT
  MILESTONE
}

enum ApprovalStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApprovalStepStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
}

enum ApprovalActionType {
  CREATED
  UPDATED
  SUBMITTED
  RESUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}

model User {
  id                          String                     @id @default(uuid()) @db.Uuid
  email                       String                     @unique @db.VarChar(320)
  name                        String                     @db.VarChar(100)
  passwordHash                String                     @map("password_hash") @db.VarChar(255)
  isActive                    Boolean                    @default(true) @map("is_active")
  platformRole                PlatformRole               @default(USER) @map("platform_role")
  createdAt                   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizationMemberships     OrganizationMembership[]
  projectMemberships          ProjectMembership[]
  createdGroups               CollaborationGroup[]       @relation("GroupCreator")
  authoredFeedPosts           FeedPost[]                 @relation("FeedPostAuthor")
  assignedFeedPosts           FeedPost[]                 @relation("FeedPostAssignee")
  feedComments                FeedComment[]
  uploadedFeedAttachments     FeedAttachment[]
  createdDriveFolders         DriveFolder[]              @relation("DriveFolderCreator")
  createdDriveFiles           DriveFile[]                @relation("DriveFileCreator")
  uploadedDriveVersions       DriveFileVersion[]         @relation("DriveVersionUploader")
  notifications               Notification[]
  createdDriveIssueLinks      DriveFileIssueLink[]       @relation("DriveIssueLinkCreator")
  createdCalendarEvents       CalendarEvent[]            @relation("CalendarEventCreator")
  assignedCalendarEvents      CalendarEvent[]            @relation("CalendarEventAssignee")
  calendarParticipations      CalendarEventParticipant[]
  uploadedCalendarAttachments CalendarEventAttachment[]
  calendarReminders           CalendarReminder[]
  createdApprovalDocuments    ApprovalDocument[]         @relation("ApprovalDocumentCreator")
  approvalRouteMemberships    ApprovalRouteMember[]
  approvalSteps               ApprovalStep[]
  approvalActions             ApprovalAction[]
  approvalNotifications       ApprovalNotification[]
  auditLogs                   AuditLog[]

  @@map("users")
}

model Organization {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String                   @db.VarChar(150)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        OrganizationMembership[]
  projects           Project[]
  projectMemberships ProjectMembership[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("organization_memberships")
}

model Project {
  id                    String                    @id @default(uuid()) @db.Uuid
  organizationId        String                    @map("organization_id") @db.Uuid
  code                  String                    @db.VarChar(50)
  name                  String                    @db.VarChar(200)
  description           String?                   @db.Text
  status                ProjectStatus             @default(PREPARING)
  startsAt              DateTime?                 @map("starts_at") @db.Date
  endsAt                DateTime?                 @map("ends_at") @db.Date
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships           ProjectMembership[]
  groups                CollaborationGroup[]
  feedPosts             FeedPost[]
  feedComments          FeedComment[]
  feedAttachments       FeedAttachment[]
  realtimeEvents        RealtimeEvent[]
  notifications         Notification[]
  driveIssueLinks       DriveFileIssueLink[]
  driveFolders          DriveFolder[]
  driveFiles            DriveFile[]
  driveVersions         DriveFileVersion[]
  calendarEvents        CalendarEvent[]
  calendarAttachments   CalendarEventAttachment[]
  approvalDocuments     ApprovalDocument[]
  approvalRevisions     ApprovalRevision[]
  approvalNotifications ApprovalNotification[]
  auditLogs             AuditLog[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("projects")
}

model ProjectMembership {
  id               String            @id @default(uuid()) @db.Uuid
  projectId        String            @map("project_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  role             ProjectRole
  status           MembershipStatus  @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  groupMemberships GroupMembership[]

  @@unique([projectId, userId])
  @@index([userId, status])
  @@index([projectId, organizationId, status])
  @@map("project_memberships")
}

model CollaborationGroup {
  id                  String                   @id @default(uuid()) @db.Uuid
  projectId           String                   @map("project_id") @db.Uuid
  name                String                   @db.VarChar(120)
  description         String?                  @db.Text
  isPrivate           Boolean                  @default(true) @map("is_private")
  createdById         String                   @map("created_by_id") @db.Uuid
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy           User                     @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships         GroupMembership[]
  feedPosts           FeedPost[]
  feedComments        FeedComment[]
  feedAttachments     FeedAttachment[]
  realtimeEvents      RealtimeEvent[]
  notifications       Notification[]
  driveFolderAccesses DriveFolderGroupAccess[]
  calendarEvents      CalendarEvent[]

  @@unique([projectId, name])
  @@index([projectId, isPrivate])
  @@map("collaboration_groups")
}

model GroupMembership {
  id                  String             @id @default(uuid()) @db.Uuid
  groupId             String             @map("group_id") @db.Uuid
  projectMembershipId String             @map("project_membership_id") @db.Uuid
  role                GroupRole          @default(MEMBER)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  group               CollaborationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  projectMembership   ProjectMembership  @relation(fields: [projectMembershipId], references: [id], onDelete: Cascade)

  @@unique([groupId, projectMembershipId])
  @@index([projectMembershipId, role])
  @@map("group_memberships")
}

model FeedPost {
  id              String               @id @default(uuid()) @db.Uuid
  projectId       String               @map("project_id") @db.Uuid
  groupId         String               @map("group_id") @db.Uuid
  authorId        String               @map("author_id") @db.Uuid
  assigneeId      String?              @map("assignee_id") @db.Uuid
  type            FeedPostType
  title           String               @db.VarChar(200)
  content         String               @db.Text
  priority        IssuePriority        @default(NORMAL)
  status          IssueStatus          @default(REGISTERED)
  tags            String[]             @default([])
  archivedAt      DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group           CollaborationGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author          User                 @relation("FeedPostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assignee        User?                @relation("FeedPostAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments        FeedComment[]
  attachments     FeedAttachment[]
  realtimeEvents  RealtimeEvent[]
  notifications   Notification[]
  driveIssueLinks DriveFileIssueLink[]
  calendarEvents  CalendarEvent[]

  @@index([projectId, groupId, archivedAt, createdAt(sort: Desc)])
  @@index([projectId, groupId, type, status, priority])
  @@index([assigneeId, status])
  @@map("feed_posts")
}

model FeedComment {
  id         String             @id @default(uuid()) @db.Uuid
  projectId  String             @map("project_id") @db.Uuid
  groupId    String             @map("group_id") @db.Uuid
  postId     String             @map("post_id") @db.Uuid
  authorId   String             @map("author_id") @db.Uuid
  parentId   String?            @map("parent_id") @db.Uuid
  content    String             @db.VarChar(4000)
  archivedAt DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group      CollaborationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  post       FeedPost           @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent     FeedComment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    FeedComment[]      @relation("CommentReplies")

  @@index([projectId, groupId, postId, archivedAt, createdAt])
  @@index([parentId, createdAt])
  @@map("feed_comments")
}

model FeedAttachment {
  id           String             @id @default(uuid()) @db.Uuid
  projectId    String             @map("project_id") @db.Uuid
  groupId      String             @map("group_id") @db.Uuid
  postId       String             @map("post_id") @db.Uuid
  uploadedById String             @map("uploaded_by_id") @db.Uuid
  originalName String             @map("original_name") @db.VarChar(255)
  storageKey   String             @unique @map("storage_key") @db.VarChar(500)
  mimeType     String             @map("mime_type") @db.VarChar(150)
  size         BigInt
  status       AttachmentStatus   @default(PREPARED)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group        CollaborationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  post         FeedPost           @relation(fields: [postId], references: [id], onDelete: Cascade)
  uploadedBy   User               @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([projectId, groupId, postId, status])
  @@map("feed_attachments")
}

model DriveFolder {
  id           String                   @id @default(uuid()) @db.Uuid
  projectId    String                   @map("project_id") @db.Uuid
  parentId     String?                  @map("parent_id") @db.Uuid
  createdById  String                   @map("created_by_id") @db.Uuid
  name         String                   @db.VarChar(120)
  isRestricted Boolean                  @default(false) @map("is_restricted")
  deletedAt    DateTime?                @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       DriveFolder?             @relation("DriveFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     DriveFolder[]            @relation("DriveFolderTree")
  createdBy    User                     @relation("DriveFolderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  files        DriveFile[]
  groupAccess  DriveFolderGroupAccess[]

  @@index([projectId, parentId, deletedAt, name])
  @@map("drive_folders")
}

model DriveFile {
  id                String               @id @default(uuid()) @db.Uuid
  projectId         String               @map("project_id") @db.Uuid
  folderId          String?              @map("folder_id") @db.Uuid
  createdById       String               @map("created_by_id") @db.Uuid
  name              String               @db.VarChar(255)
  deletedAt         DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder            DriveFolder?         @relation(fields: [folderId], references: [id], onDelete: Restrict)
  createdBy         User                 @relation("DriveFileCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions          DriveFileVersion[]
  issueLinks        DriveFileIssueLink[]
  approvalDocuments ApprovalDocument[]

  @@index([projectId, folderId, deletedAt, name])
  @@map("drive_files")
}

model DriveFileVersion {
  id                String             @id @default(uuid()) @db.Uuid
  projectId         String             @map("project_id") @db.Uuid
  fileId            String             @map("file_id") @db.Uuid
  uploadedById      String             @map("uploaded_by_id") @db.Uuid
  version           Int
  originalName      String             @map("original_name") @db.VarChar(255)
  storageKey        String             @unique @map("storage_key") @db.VarChar(500)
  mimeType          String             @map("mime_type") @db.VarChar(150)
  size              BigInt
  status            DriveVersionStatus @default(PREPARED)
  sha256            String?            @db.Char(64)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file              DriveFile          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy        User               @relation("DriveVersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  approvalDocuments ApprovalDocument[]
  approvalRevisions ApprovalRevision[]

  @@unique([fileId, version])
  @@index([projectId, fileId, status, version(sort: Desc)])
  @@map("drive_file_versions")
}

model DriveFolderGroupAccess {
  id        String             @id @default(uuid()) @db.Uuid
  folderId  String             @map("folder_id") @db.Uuid
  groupId   String             @map("group_id") @db.Uuid
  canWrite  Boolean            @default(false) @map("can_write")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  folder    DriveFolder        @relation(fields: [folderId], references: [id], onDelete: Cascade)
  group     CollaborationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([folderId, groupId])
  @@index([groupId, canWrite])
  @@map("drive_folder_group_accesses")
}

model DriveFileIssueLink {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  fileId      String    @map("file_id") @db.Uuid
  postId      String    @map("post_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file        DriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  post        FeedPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("DriveIssueLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([fileId, postId])
  @@index([projectId, postId])
  @@map("drive_file_issue_links")
}

model CalendarEvent {
  id              String                     @id @default(uuid()) @db.Uuid
  projectId       String                     @map("project_id") @db.Uuid
  groupId         String?                    @map("group_id") @db.Uuid
  createdById     String                     @map("created_by_id") @db.Uuid
  assigneeId      String?                    @map("assignee_id") @db.Uuid
  issueId         String?                    @map("issue_id") @db.Uuid
  kind            CalendarEventKind          @default(EVENT)
  title           String                     @db.VarChar(200)
  description     String?                    @db.Text
  startsAt        DateTime                   @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime                   @map("ends_at") @db.Timestamptz(3)
  allDay          Boolean                    @default(false) @map("all_day")
  milestoneName   String?                    @map("milestone_name") @db.VarChar(100)
  reminderMinutes Int                        @default(1440) @map("reminder_minutes")
  archivedAt      DateTime?                  @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  project         Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group           CollaborationGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy       User                       @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee        User?                      @relation("CalendarEventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  issue           FeedPost?                  @relation(fields: [issueId], references: [id], onDelete: SetNull)
  participants    CalendarEventParticipant[]
  attachments     CalendarEventAttachment[]
  reminders       CalendarReminder[]

  @@index([projectId, startsAt, endsAt, archivedAt])
  @@index([projectId, groupId, kind])
  @@index([assigneeId, startsAt])
  @@map("calendar_events")
}

model CalendarEventParticipant {
  id        String        @id @default(uuid()) @db.Uuid
  eventId   String        @map("event_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, eventId])
  @@map("calendar_event_participants")
}

model CalendarEventAttachment {
  id           String           @id @default(uuid()) @db.Uuid
  projectId    String           @map("project_id") @db.Uuid
  eventId      String           @map("event_id") @db.Uuid
  uploadedById String           @map("uploaded_by_id") @db.Uuid
  originalName String           @map("original_name") @db.VarChar(255)
  storageKey   String           @unique @map("storage_key") @db.VarChar(500)
  mimeType     String           @map("mime_type") @db.VarChar(150)
  size         BigInt
  status       AttachmentStatus @default(PREPARED)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event        CalendarEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy   User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([projectId, eventId, status])
  @@map("calendar_event_attachments")
}

model CalendarReminder {
  id          String        @id @default(uuid()) @db.Uuid
  eventId     String        @map("event_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  scheduledAt DateTime      @map("scheduled_at") @db.Timestamptz(3)
  readAt      DateTime?     @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  event       CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, readAt, scheduledAt])
  @@map("calendar_reminders")
}

model ApprovalDocument {
  id              String                 @id @default(uuid()) @db.Uuid
  projectId       String                 @map("project_id") @db.Uuid
  createdById     String                 @map("created_by_id") @db.Uuid
  fileId          String                 @map("file_id") @db.Uuid
  fileVersionId   String                 @map("file_version_id") @db.Uuid
  title           String                 @db.VarChar(200)
  content         String                 @db.Text
  status          ApprovalStatus         @default(DRAFT)
  currentRevision Int                    @default(0) @map("current_revision")
  submittedAt     DateTime?              @map("submitted_at") @db.Timestamptz(3)
  approvedAt      DateTime?              @map("approved_at") @db.Timestamptz(3)
  rejectedAt      DateTime?              @map("rejected_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User                   @relation("ApprovalDocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  file            DriveFile              @relation(fields: [fileId], references: [id], onDelete: Restrict)
  fileVersion     DriveFileVersion       @relation(fields: [fileVersionId], references: [id], onDelete: Restrict)
  routeMembers    ApprovalRouteMember[]
  revisions       ApprovalRevision[]
  actions         ApprovalAction[]
  notifications   ApprovalNotification[]

  @@index([projectId, status, updatedAt(sort: Desc)])
  @@index([createdById, status])
  @@map("approval_documents")
}

model ApprovalRouteMember {
  id         String           @id @default(uuid()) @db.Uuid
  documentId String           @map("document_id") @db.Uuid
  approverId String           @map("approver_id") @db.Uuid
  sequence   Int
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  document   ApprovalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approver   User             @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@unique([documentId, sequence])
  @@unique([documentId, approverId])
  @@index([approverId, documentId])
  @@map("approval_route_members")
}

model ApprovalRevision {
  id                 String           @id @default(uuid()) @db.Uuid
  documentId         String           @map("document_id") @db.Uuid
  projectId          String           @map("project_id") @db.Uuid
  fileVersionId      String           @map("file_version_id") @db.Uuid
  revision           Int
  titleSnapshot      String           @map("title_snapshot") @db.VarChar(200)
  contentSnapshot    String           @map("content_snapshot") @db.Text
  fileNameSnapshot   String           @map("file_name_snapshot") @db.VarChar(255)
  fileVersion        Int              @map("file_version")
  fileSha256         String           @map("file_sha256") @db.Char(64)
  storageKeySnapshot String           @map("storage_key_snapshot") @db.VarChar(500)
  mimeTypeSnapshot   String           @map("mime_type_snapshot") @db.VarChar(150)
  sizeSnapshot       BigInt           @map("size_snapshot")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  document           ApprovalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceVersion      DriveFileVersion @relation(fields: [fileVersionId], references: [id], onDelete: Restrict)
  steps              ApprovalStep[]
  actions            ApprovalAction[]

  @@unique([documentId, revision])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("approval_revisions")
}

model ApprovalStep {
  id         String             @id @default(uuid()) @db.Uuid
  revisionId String             @map("revision_id") @db.Uuid
  approverId String             @map("approver_id") @db.Uuid
  sequence   Int
  status     ApprovalStepStatus @default(PENDING)
  comment    String?            @db.VarChar(1000)
  decidedAt  DateTime?          @map("decided_at") @db.Timestamptz(3)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  revision   ApprovalRevision   @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  approver   User               @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@unique([revisionId, sequence])
  @@index([approverId, status, createdAt])
  @@map("approval_steps")
}

model ApprovalAction {
  id         String             @id @default(uuid()) @db.Uuid
  documentId String             @map("document_id") @db.Uuid
  revisionId String?            @map("revision_id") @db.Uuid
  actorId    String             @map("actor_id") @db.Uuid
  type       ApprovalActionType
  fromStatus ApprovalStatus?    @map("from_status")
  toStatus   ApprovalStatus     @map("to_status")
  comment    String?            @db.VarChar(1000)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  document   ApprovalDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  revision   ApprovalRevision?  @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  actor      User               @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@map("approval_actions")
}

model ApprovalNotification {
  id         String           @id @default(uuid()) @db.Uuid
  documentId String           @map("document_id") @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       String           @db.VarChar(80)
  message    String           @db.VarChar(500)
  readAt     DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  document   ApprovalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("approval_notifications")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String   @map("resource_id") @db.Uuid
  requestId    String?  @map("request_id") @db.VarChar(100)
  summary      Json
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([projectId, resourceType, resourceId, occurredAt])
  @@map("audit_logs")
}

model RealtimeEvent {
  id            String             @id @default(uuid()) @db.Uuid
  eventKey      String             @unique @map("event_key") @db.Uuid
  projectId     String             @map("project_id") @db.Uuid
  groupId       String             @map("group_id") @db.Uuid
  postId        String?            @map("post_id") @db.Uuid
  type          String             @db.VarChar(80)
  payload       Json
  occurredAt    DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(3)
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group         CollaborationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  post          FeedPost?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([projectId, groupId, occurredAt, eventKey])
  @@map("realtime_events")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  eventId   String             @map("event_id") @db.Uuid
  projectId String             @map("project_id") @db.Uuid
  groupId   String             @map("group_id") @db.Uuid
  postId    String?            @map("post_id") @db.Uuid
  type      String             @db.VarChar(80)
  message   String             @db.VarChar(500)
  readAt    DateTime?          @map("read_at") @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     RealtimeEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group     CollaborationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  post      FeedPost?          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([projectId, groupId, postId])
  @@map("notifications")
}
