{
  "name": "project-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @project-hub/api --filter @project-hub/web dev",
    "dev:web": "pnpm --filter @project-hub/web dev",
    "dev:api": "pnpm --filter @project-hub/api dev",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @project-hub/api db:generate",
    "db:migrate": "pnpm --filter @project-hub/api db:migrate",
    "db:deploy": "pnpm --filter @project-hub/api db:deploy",
    "db:seed": "pnpm --filter @project-hub/api db:seed",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
