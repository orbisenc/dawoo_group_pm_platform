# 실행 환경
NODE_ENV=development
WEB_PORT=3004
API_PORT=4000
WEB_ORIGIN=http://localhost:3004
NEXT_PUBLIC_API_BASE_URL=/backend
NEXT_PUBLIC_API_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_ENABLE_TEST_AUTH=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com

# 승인된 Gmail 회원을 다우그룹 공유 드라이브에 편집자로 초대하는 서버 서비스 계정
# 서비스 계정에 대상 공유 드라이브의 관리자 권한을 먼저 부여해야 합니다.
GOOGLE_SERVICE_ACCOUNT_EMAIL=project-hub-drive@YOUR_PROJECT.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SHARED_DRIVE_NAME=다우그룹_공유 드라이브
# Google Workspace 도메인 위임을 사용할 때만 설정합니다.
GOOGLE_SERVICE_ACCOUNT_SUBJECT=
API_INTERNAL_URL=http://localhost:4000
AUTH_TOKEN_SECRET=project_hub_local_auth_secret_change_in_production
ENABLE_DEV_AUTH=true

# Autodesk Platform Services 무료 티어 CAD 뷰어
# APS 개발자 허브에서 앱을 만든 뒤 서버에만 설정합니다. Client Secret은 NEXT_PUBLIC_ 변수로 노출하지 않습니다.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# 전역에서 고유한 소문자 버킷 키입니다. 비워 두면 Client ID 해시로 자동 생성합니다.
APS_BUCKET_KEY=
APS_REGION=US
# /api/v1/operations/metrics 접근용 운영 전용 토큰. 운영에서는 충분히 긴 무작위 값을 사용합니다.
METRICS_TOKEN=project_hub_local_metrics_secret_change_in_production

# PostgreSQL
POSTGRES_DB=project_hub
POSTGRES_USER=project_hub
POSTGRES_PASSWORD=project_hub_local
DATABASE_URL=postgresql://project_hub:project_hub_local@localhost:5432/project_hub?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# S3 호환 저장소(RustFS 로컬 구성)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-northeast-2
S3_BUCKET=project-hub-local
S3_ACCESS_KEY=project_hub
S3_SECRET_KEY=project_hub_local_secret
S3_FORCE_PATH_STYLE=true
