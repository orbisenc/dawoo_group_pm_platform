# 실행 환경
NODE_ENV=development
WEB_PORT=3004
API_PORT=4000
WEB_ORIGIN=http://localhost:3004
NEXT_PUBLIC_API_BASE_URL=/backend
NEXT_PUBLIC_API_SOCKET_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
AUTH_TOKEN_SECRET=project_hub_local_auth_secret_change_in_production
ENABLE_DEV_AUTH=true

# PostgreSQL
POSTGRES_DB=project_hub
POSTGRES_USER=project_hub
POSTGRES_PASSWORD=project_hub_local
DATABASE_URL=postgresql://project_hub:project_hub_local@localhost:5432/project_hub?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# S3 호환 저장소(MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-northeast-2
S3_BUCKET=project-hub-local
S3_ACCESS_KEY=project_hub
S3_SECRET_KEY=project_hub_local_secret
S3_FORCE_PATH_STYLE=true

# MinIO 관리 콘솔
MINIO_ROOT_USER=project_hub
MINIO_ROOT_PASSWORD=project_hub_local_secret
